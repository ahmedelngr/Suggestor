# Copy to .env (never commit .env). Get values from the Supabase dashboard / team password manager.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key-safe-for-the-app
# Supabase dashboard > Connect > Session pooler. Not "Direct connection": that one is IPv6-only.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Not used by the backend. Leave empty. NEVER ship in the app.
SUPABASE_SERVICE_ROLE_KEY=
# Hugging Face token for the data loader (data/README.md).
HF_TOKEN=

# Backend settings. All optional; these are the defaults.
# Web addresses allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Days a swiped restaurant stays out of the feed.
COOLDOWN_DAYS=14
# Taste weights: how much a like adds and a pass subtracts (placeholders until Modeling recommends values).
LIKE_WEIGHT=1.0
DISLIKE_WEIGHT=0.5
