# Copy to .env (never commit .env). Get values from the Supabase dashboard / team password manager.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key-safe-for-the-app
# Server-side scripts only (Yelp ingestion, ML). NEVER ship in the app.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
YELP_API_KEY=
